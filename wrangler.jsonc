{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-platform",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Per-IP limit for uncached /api/solana/token-market lookups (protects
  // the Helius free tier). functions/api/solana/token-market.js falls back
  // to a per-instance limit when this binding isn't available.
  "ratelimits": [
    {
      "name": "TOKEN_MARKET_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
