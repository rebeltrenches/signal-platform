# Copy to .env.local and fill in. Never commit real secrets or private keys.

# --- Application ----------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database / cache -----------------------------------------------------
DATABASE_URL=postgresql://launchpad:launchpad_dev_only@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379

# --- Auth -----------------------------------------------------------------
AUTH_SECRET=change_me_generate_a_real_random_secret

# --- Solana ---------------------------------------------------------------
# Production builds use Mainnet unless SIGNAL_SOLANA_CLUSTER=devnet is set
# deliberately for a test build. Never deploy a devnet build as production.
SOLANA_RPC_URL=
SOLANA_WS_URL=
# Leave blank for Mainnet. Use exactly "devnet" only for a disposable test build.
SIGNAL_SOLANA_CLUSTER=
# Public program ID only. Never place an upgrade-authority/private key here.
# If this is blank, the website deliberately disables Signal token launching
# rather than falling back to the legacy all-supply-to-creator launch flow.
SIGNAL_BONDING_CURVE_PROGRAM_ID=

# --- Future EVM networks --------------------------------------------------
BASE_RPC_URL=
BASE_WS_URL=
BNB_RPC_URL=
BNB_WS_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# --- Indexing -------------------------------------------------------------
INDEXER_ENABLED=true
INDEXER_BATCH_SIZE=200
INDEXER_CONFIRMATIONS=32

# --- Current Signal fee model --------------------------------------------
# Source of truth for live transaction behavior is the on-chain program and
# packages/config + packages/types, not these documentation values.
# Current Solana launch fee: 0.001 SOL paid to the Signal platform wallet.
LAUNCH_FEE_LAMPORTS=1000000
# Current Signal trading fee: 1% (100 bps) of eligible Signal-routed Solana
# trades. On the pre-graduation bonding curve it is enforced on-chain and paid
# in SOL. It is NOT a token transfer tax and ordinary wallet transfers do not
# incur it.
PLATFORM_TRADING_FEE_BPS=100

# The old DEFAULT_TOTAL_TAX_BPS / creator Transfer Fee model is intentionally
# gone. New Signal Solana launches use classic SPL Token with no Token-2022
# transfer tax. The full token supply starts in the program-owned bonding-curve
# vault; the creator receives no automatic token allocation.

# Server-side only. Required by the external Jupiter route used for tokens that
# are not on an active Signal bonding curve. Never expose this key in browser code.
JUPITER_API_KEY=
