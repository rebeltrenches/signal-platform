# Copy to .env.local and fill in. Never commit the real file.

# --- Application -------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database / cache ----------------------------------------------------
DATABASE_URL=postgresql://launchpad:launchpad_dev_only@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
AUTH_SECRET=change_me_generate_a_real_random_secret

# --- Blockchain RPC — mainnet (leave blank until you're actually ready) ---
SOLANA_RPC_URL=
SOLANA_WS_URL=
BASE_RPC_URL=
BASE_WS_URL=
BNB_RPC_URL=
BNB_WS_URL=

# --- Blockchain RPC — testnet ---------------------------------------------
# Solana: NONE. Devnet is permanently excluded for Solana (decided
# 2026-09-17, docs/ROADMAP.md Stage 6) — there is deliberately no
# SOLANA_DEVNET_RPC_URL here. The eventual target is Solana Mainnet only.
# Base/BNB testnets are a separate, not-yet-revisited decision (Stage 7
# hasn't started) — left in place for when that stage is actually picked up.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# --- Indexing ----------------------------------------------------------
INDEXER_ENABLED=true
INDEXER_BATCH_SIZE=200
INDEXER_CONFIRMATIONS=32
# How often the indexer refresh loop runs (apps/indexer).
INDEXER_INTERVAL_MS=

# --- Treasury / fees -----------------------------------------------------
PLATFORM_TREASURY_ADDRESS=
LAUNCH_FEE_LAMPORTS=0
PLATFORM_TRADING_FEE_BPS=0

# --- Transfer fee (Solana only for now — see docs/ARCHITECTURE.md ADR-0003) ---
DEFAULT_TOTAL_TAX_BPS=100
# No DEFAULT_PLATFORM_TAX_BPS / DEFAULT_HOLDER_REWARD_TAX_BPS — there is no
# split. 100% of the Transfer Fee goes to the token's own creator, who holds
# withdrawWithheldAuthority themselves (confirmed 2026-09-17, final state
# after multiple reversals — see docs/ARCHITECTURE.md ADR-0009 for the full
# history). Signal holds no fee-related key and needs none of the env vars
# this section used to list (SIGNAL_PLATFORM_WALLET_ADDRESS,
# SIGNAL_FEE_AUTHORITY_PRIVATE_KEY, SIGNAL_REWARDS_POOL_AUTHORITY_PRIVATE_KEY)
# — all removed along with the SolanaFeeOperations.ts class and apps/worker
# script that used them. This var name keeps "TAX" for backward
# compatibility; the product itself says "Transfer Fee" everywhere a person
# reads it — see the terminology note in docs/ARCHITECTURE.md.
# These are DEFAULTS for the launch-creation form only. The contract/program
# enforces its own ceiling independently (PROTOCOL_MAX_TAX_BPS in
# packages/types) — env vars are never trusted as the source of truth inside
# a contract, per spec section 47's own explicit warning.
# Do not describe this fee as "a Signal platform fee" anywhere — it's the
# creator's fee, and the UI must distinguish creator / creator fee / Signal
# platform functionality / future airdrops as four separate concepts.
# Server-side only. Required by /api/solana/swap/quote; never expose this in browser code.
JUPITER_API_KEY=

# --- Signal API on Render (apps/api) --------------------------------------
# Also needs DATABASE_URL, AUTH_SECRET and SOLANA_RPC_URL from above.
# "database" switches ALL API storage (tokens, chat, watchlist, alerts,
# launches, wallets) to Postgres; anything else keeps it in memory.
CHAT_STORAGE=database
# Comma-separated exact frontend origins allowed to call the API.
CORS_ORIGINS=
# Shared with the Cloudflare Worker (same value in both places). The API
# accepts token registrations only through the Worker with this secret.
SIGNAL_EDGE_SECRET=
# "true" only behind a proxy that sets X-Forwarded-For (Render does).
TRUST_PROXY=
# Comma-separated wallet addresses allowed to moderate chat.
CHAT_MODERATOR_WALLETS=
# Optional tuning (defaults in apps/api/src/router.ts).
API_RATE_LIMIT_MAX=
API_RATE_LIMIT_WINDOW_MS=
API_MAX_BODY_BYTES=
# Devnet test APIs only: "devnet" allows direct registration without the
# Worker, and only when SOLANA_RPC_URL is a Devnet endpoint. Never set it
# on the Mainnet API.
SIGNAL_TEST_ALLOW_DIRECT_REGISTRATION=

# --- Cloudflare Worker (worker.js, functions/) -----------------------------
# Secrets set in Cloudflare (Production and Previews): SIGNAL_EDGE_SECRET,
# SOLANA_RPC_URL, JUPITER_API_KEY. SIGNAL_API_ORIGIN is a plain var in
# wrangler.jsonc. Optional override of the OFAC list file (https only):
OFAC_LIST_URL=

# --- Web build (apps/web/scripts/build.tsx) --------------------------------
# API base URL baked into the site; "devnet" builds a Devnet test site.
SIGNAL_API_BASE_URL=
SIGNAL_SOLANA_CLUSTER=
